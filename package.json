{
  "name": "eztrade",
  "private": true,
  "workspaces": [
    "web",
    "app"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace web",
    "dev:app": "npm run start --workspace app",
    "build:web": "npm run build --workspace web",
    "dev:api": "php api/artisan serve",
    "setup:api": "composer install --working-dir=api"
  }
}
